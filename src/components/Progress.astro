---
import type { PlannedLesson } from "../data/lesson-plan";

interface Props {
  current: string;
  items: PlannedLesson[];
  markable?: boolean;
}

const { current, items, markable = true } = Astro.props;
const place = items.findIndex((item) => item.slug === current) + 1;
---

<nav class="lesson-progress" aria-label="Lessons in this module" data-progress data-current={current}>
  <p class="progress-label">
    Lesson {place} of {items.length}
    <span data-progress-count></span>
  </p>
  <ol>
    {
      items.map((item) => (
        <li>
          <a
            href={item.href}
            data-slug={item.slug}
            aria-current={item.slug === current ? "page" : undefined}
          >
            <span class="progress-num">{items.indexOf(item) + 1}</span>
            {item.title}
          </a>
        </li>
      ))
    }
  </ol>
  {
    markable && (
      <button type="button" class="button ghost" data-mark-done>
        Mark this lesson done
      </button>
    )
  }
</nav>

<script>
  const key = "sophandros.done";

  function read(): string[] {
    try {
      const value = JSON.parse(localStorage.getItem(key) || "[]");
      return Array.isArray(value) ? value.filter((item) => typeof item === "string") : [];
    } catch {
      return [];
    }
  }

  function paint() {
    const done = new Set(read());
    document.querySelectorAll("[data-slug]").forEach((node) => {
      if (!(node instanceof HTMLElement)) return;
      node.classList.toggle("is-done", done.has(node.dataset.slug || ""));
    });
    document.querySelectorAll("[data-lesson-status]").forEach((node) => {
      if (!(node instanceof HTMLElement)) return;
      if (done.has(node.dataset.lessonStatus || "")) node.textContent = "Done";
    });
    document.querySelectorAll("[data-progress]").forEach((root) => {
      if (!(root instanceof HTMLElement)) return;
      const slugs = [...root.querySelectorAll("[data-slug]")].map(
        (node) => (node as HTMLElement).dataset.slug || "",
      );
      const finished = slugs.filter((slug) => done.has(slug)).length;
      const count = root.querySelector("[data-progress-count]");
      if (count) count.textContent = ` · ${finished} of ${slugs.length} marked done on this browser`;
      const button = root.querySelector("[data-mark-done]");
      const current = root.dataset.current || "";
      if (button) button.textContent = done.has(current) ? "Marked done" : "Mark this lesson done";
    });
  }

  paint();
  document.querySelectorAll("[data-mark-done]").forEach((button) => {
    button.addEventListener("click", () => {
      const root = button.closest("[data-progress]");
      if (!(root instanceof HTMLElement)) return;
      const current = root.dataset.current || "";
      const done = new Set(read());
      if (done.has(current)) done.delete(current);
      else done.add(current);
      localStorage.setItem(key, JSON.stringify([...done]));
      paint();
    });
  });
</script>
