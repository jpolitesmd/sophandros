---
import { Image } from "astro:assets";
import medallion from "../assets/brand/mark.png";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const links = [
  { href: "/curriculum", label: "Curriculum" },
  { href: "/references", label: "References" },
  { href: "/founders", label: "Founders" },
  { href: "/about", label: "The name" },
  { href: "/waitlist", label: "Waitlist", cta: true },
];

function current(href: string) {
  return path === href || path.startsWith(`${href}/`);
}
---

<header class="site-header">
  <div class="edge" aria-hidden="true"></div>
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-current={path === "/" ? "page" : undefined}>
      <Image
        src={medallion}
        alt=""
        width={128}
        height={128}
        densities={[1]}
        format="png"
        quality={100}
        class="brand-mark"
        loading="eager"
      />
      <span class="brand-name">Sophandros</span>
    </a>
    <nav class="nav-bar" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={link.href}
            class={link.cta ? "nav-cta" : undefined}
            aria-current={current(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <details class="nav-drawer">
      <summary>
        <span class="sr-only">Menu</span>
        <span class="bars" aria-hidden="true"></span>
      </summary>
      <nav aria-label="Primary">
        {
          links.map((link) => (
            <a
              href={link.href}
              class={link.cta ? "nav-cta" : undefined}
              aria-current={current(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>
