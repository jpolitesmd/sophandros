---
import References from "./References.astro";
import { plainLessonTitle, type BookLesson } from "../data/book";

interface Props {
  lesson: BookLesson;
}

const { lesson } = Astro.props;
---

<details class="ref-lesson" id={lesson.slug}>
  <summary>
    <span class="ref-num">{lesson.n}</span>
    <span class="ref-title">{plainLessonTitle(lesson.title)}</span>
  </summary>
  <div class="ref-body">
    {
      lesson.href && (
        <p class="ref-read">
          <a href={lesson.href}>Read the lesson</a>
        </p>
      )
    }
    <References slug={lesson.slug} compact />
  </div>
</details>
