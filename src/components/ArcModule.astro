---
import type { OutlineModule } from "../data/arc";
import { moduleHref } from "../data/curriculum";

interface Props {
  module: OutlineModule;
  /** Greece modules link to a syllabus page and, when taught, to lessons. */
  linked?: boolean;
}

const { module, linked = false } = Astro.props;
---

<section class="module-lessons" id={module.slug ?? module.code}>
  <header>
    <p class="kicker">{module.code} · {module.layer}</p>
    <h3>
      {
        linked && module.slug ? (
          <a href={moduleHref(module.slug)}>{module.title}</a>
        ) : (
          module.title
        )
      }
    </h3>
    <p class="module-who">
      {module.who}. {module.era}
    </p>
  </header>
  {
    module.lessons.length > 0 && (
      <ol class="lesson-list">
        {module.lessons.map((lesson, index) => (
          <li id={lesson.slug}>
            <a href={lesson.href}>
              <span class="lesson-index">{index === 0 ? "0" : index}</span>
              <span class="lesson-name">{lesson.title}</span>
              <span class="lesson-time">about {lesson.minutes} min</span>
              <span
                class="badge"
                data-lesson-status={lesson.status === "available" ? lesson.slug : undefined}
                data-slug={lesson.slug}
              >
                {lesson.status === "available" ? "Available" : "Coming soon"}
              </span>
            </a>
          </li>
        ))}
      </ol>
    )
  }
  <p class="failure">
    <strong>What failed, and what the next age learned.</strong> {module.failed}{" "}
    <em>{module.carried}</em>
  </p>
</section>
