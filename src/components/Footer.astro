---
import { Image } from "astro:assets";
import medallion from "../assets/brand/mark-navy.png";
import { site } from "../data/site";

const links = [
  { href: "/curriculum", label: "Curriculum" },
  { href: "/references", label: "References" },
  { href: "/founders", label: "Founders Edition" },
  { href: "/about", label: "The name" },
  { href: "/waitlist", label: "Waitlist" },
];
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <a class="footer-brand" href="/">
        <Image
          src={medallion}
          alt=""
          width={160}
          height={210}
          densities={[1]}
          format="png"
          quality={100}
          class="brand-mark"
        />
        <span class="brand-name">Sophandros</span>
      </a>
      <p class="footer-note">{site.tagline}</p>
    </div>
    <div>
      <h2>Read</h2>
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h2>Write</h2>
      <ul>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={site.url}>{site.domain}</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap">
    <p class="fine">
      A preview of the course. Phase I, Greece, is drafted. Rome, the Renaissance,
      and enrollment are still ahead. This preview is not an offer of a place.
    </p>
  </div>
</footer>
