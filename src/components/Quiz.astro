---
export interface QuizItem {
  prompt: string;
  choices: string[];
  answer: number;
  explain: string;
}

interface Props {
  items: QuizItem[];
}

const { items } = Astro.props;
---

<section class="quiz" aria-labelledby="recall">
  <h2 id="recall">Recall</h2>
  <p>These questions ask only for what this lesson has already said.</p>
  <ol class="quiz-list">
    {
      items.map((item, index) => (
        <li class="quiz-item">
          <fieldset>
            <legend>
              {index + 1}. {item.prompt}
            </legend>
            {item.choices.map((choice, choiceIndex) => (
              <label>
                <input type="radio" name={`q${index}`} value={String(choiceIndex)} />
                <span>{choice}</span>
              </label>
            ))}
            <button type="button" class="button quiz-check" data-answer={item.answer}>
              Check
            </button>
            <p class="quiz-result" role="status" hidden />
            <template class="quiz-explain">{item.explain}</template>
          </fieldset>
        </li>
      ))
    }
  </ol>
</section>

<script>
  document.querySelectorAll(".quiz-check").forEach((button) => {
    button.addEventListener("click", () => {
      if (!(button instanceof HTMLButtonElement)) return;
      const field = button.closest("fieldset");
      if (!field) return;
      const result = field.querySelector(".quiz-result");
      const stored = field.querySelector(".quiz-explain");
      if (!(result instanceof HTMLElement) || !(stored instanceof HTMLTemplateElement)) return;
      const chosen = field.querySelector<HTMLInputElement>("input:checked");
      result.hidden = false;
      if (!chosen) {
        result.className = "quiz-result";
        result.textContent = "Choose one of the answers, then check it.";
        return;
      }
      const right = chosen.value === button.dataset.answer;
      result.className = right ? "quiz-result is-right" : "quiz-result is-wrong";
      const lead = right ? "Yes. " : "Not quite. ";
      result.textContent = lead + (stored.content.textContent || "").trim();
    });
  });
</script>
