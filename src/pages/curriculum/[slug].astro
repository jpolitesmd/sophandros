---
import Base from "../../layouts/Base.astro";
import Excerpt from "../../components/Excerpt.astro";
import Rich from "../../components/Rich.astro";
import { greeceModules, moduleHref, type GreeceModule } from "../../data/curriculum";
import { moduleExcerpts } from "../../data/excerpts";
import { layerFor } from "../../data/layers";
import { arcFor } from "../../data/arc";

export function getStaticPaths() {
  return greeceModules.map((module) => ({
    params: { slug: module.slug },
    props: { module },
  }));
}

interface Props {
  module: GreeceModule;
}

const { module } = Astro.props;
const layer = layerFor(module.slug);
const arc = arcFor(module.slug);
const passages = moduleExcerpts[module.slug] ?? [];
const index = greeceModules.findIndex((item) => item.slug === module.slug);
const prev = index > 0 ? greeceModules[index - 1] : undefined;
const next = index < greeceModules.length - 1 ? greeceModules[index + 1] : undefined;
---

<Base
  title={module.title}
  description={`${module.code} ${module.title}. ${module.card}`}
>
  <div class="wrap-narrow">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/curriculum">Curriculum</a></li>
        <li>Phase I · Greece</li>
        <li aria-current="page">{module.title}</li>
      </ol>
    </nav>

    <header class="page-head" style="padding-top:1.25rem">
      <p class="kicker">
        Phase I · Module {module.code} · {module.length}
        {layer && ` · Layer ${layer.n}`}
      </p>
      <h1>{module.title}</h1>
      <p class="lede"><Rich text={module.card} /></p>
    </header>

    {
      layer && (
        <section class="scene" aria-labelledby="scene-title">
          <h2 id="scene-title">Setting the scene</h2>
          <p class="scene-today">
            This layer adds {layer.virtue.toLowerCase()} to the foundation: {layer.who.toLowerCase()}, {layer.age}.
          </p>
          <p>{layer.scene}</p>
          {arc && (
            <p class="failure">
              <strong>What failed, and what the next age learned.</strong> {arc.failed}{" "}
              <em>{arc.carried}</em>
            </p>
          )}
        </section>
      )
    }

    <p><Rich text={module.theme} /></p>

    {
      passages.length > 0 && (
        <section class="excerpts" aria-labelledby="from-the-text">
          <h2 id="from-the-text">From the text</h2>
          <p class="excerpt-note">
            Short passages from this module’s readings, in public-domain translations.
          </p>
          {passages.map((excerpt) => (
            <Excerpt excerpt={excerpt} />
          ))}
        </section>
      )
    }

    <dl class="facts">
      {
        module.facts.map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd>
              <Rich text={fact.body} />
            </dd>
          </div>
        ))
      }
      <div>
        <dt>Latin</dt>
        <dd>
          <Rich text={module.latin} />
        </dd>
      </div>
      <div>
        <dt>Greek</dt>
        <dd>
          <Rich text={module.greek} />
        </dd>
      </div>
    </dl>

    <h2>The readings</h2>
    <p style="max-width:var(--measure)">
      Each lesson is about half an hour, plus the reading. The extra work listed
      with a week, such as a language chapter or a double translation, is
      optional. You do not need it to read the lesson.
    </p>
    <ol class="weeks">
      {
        module.weeks.map((week, i) => (
          <li class="week" id={week.anchor ?? `week-${i + 1}`}>
            <h2>
              <span>Reading {i + 1}</span>
              {week.title}
            </h2>
            <p class="label">Read</p>
            <p>
              <Rich text={week.read} />
            </p>
            <p class="label">Look</p>
            <p>
              <Rich text={week.look} />
            </p>
            {week.practice && (
              <>
                <p class="label">Do</p>
                <p>
                  <Rich text={week.practice} />
                </p>
              </>
            )}
            {week.lesson && (
              <p class="lesson-jump">
                <a href={week.lesson}>Read the taught lesson</a>
                <span>
                  The lesson explains the reading and answers the lines below. In these
                  early weeks those lines are not set as open work.
                </span>
              </p>
            )}
            <p class="label">Questions</p>
            <ul class="questions">
              {week.questions.map((question) => (
                <li>
                  <Rich text={question} />
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>

    <h2>Module work</h2>
    <p>Written work to finish before you move on. It is for you: no marks, no grader.</p>
    <ol class="check-list">
      {
        module.mastery.map((item) => (
          <li>
            <Rich text={item} />
          </li>
        ))
      }
    </ol>

    {
      module.capstone && (
        <>
          <h2>Phase I capstone</h2>
          <p>
            <Rich text={module.capstone.intro} />
          </p>
          <ol class="check-list">
            {module.capstone.items.map((item) => (
              <li>
                <Rich text={item} />
              </li>
            ))}
          </ol>
        </>
      )
    }


    <nav class="pager" aria-label="Modules">
      {
        prev ? (
          <a href={moduleHref(prev.slug)}>← {prev.code} {prev.title}</a>
        ) : (
          <a href="/curriculum">← All modules</a>
        )
      }
      {
        next ? (
          <a href={moduleHref(next.slug)}>{next.code} {next.title} →</a>
        ) : (
          <a href="/curriculum#rome">Rome, coming soon →</a>
        )
      }
    </nav>
  </div>
</Base>
