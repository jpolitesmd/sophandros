---
import Base from "../../layouts/Base.astro";
import CurriculumLesson from "../../components/CurriculumLesson.astro";
import OpenHash from "../../components/OpenHash.astro";
import {
  bookLessons,
  chapterLabel,
  curriculumSections,
  lessonCountLabel,
  sectionLessonCount,
} from "../../data/book";
---

<Base
  title="Curriculum"
  description="The curriculum: a prologue, four parts, and a capstone. One hundred forty lessons, from Homer to the Founding."
>
  <header class="page-head wrap-narrow">
    <p class="kicker">The course</p>
    <h1>Curriculum</h1>
    <p class="lede">
      {bookLessons.length} lessons. Open a part, then a chapter. A title in ink
      can be read now. A title in grey is still to be written.
    </p>
  </header>

  <div class="wrap-narrow folds">
    {
      curriculumSections.map((section) => (
        <details class="fold" id={section.id}>
          <summary>
            <span class="fold-title">{section.title}</span>
            <span class="fold-meta">
              <span class="fold-ring">{section.ring}</span>
              <span class="fold-count">{lessonCountLabel(sectionLessonCount(section))}</span>
            </span>
          </summary>
          <div class="fold-body">
            {section.lessons && (
              <ol class="toc-lessons">
                {section.lessons.map((lesson) => (
                  <CurriculumLesson lesson={lesson} />
                ))}
              </ol>
            )}
            {section.chapters?.map((chapter) => (
              <details class="fold fold-chapter" id={chapter.id}>
                <summary>
                  <span class="fold-title">{chapterLabel(chapter)}</span>
                  <span class="fold-meta">
                    <span class="fold-ring">{chapter.ring}</span>
                    <span class="fold-count">{lessonCountLabel(chapter.lessons.length)}</span>
                  </span>
                </summary>
                <ol class="toc-lessons">
                  {chapter.lessons.map((lesson) => (
                    <CurriculumLesson lesson={lesson} />
                  ))}
                </ol>
              </details>
            ))}
          </div>
        </details>
      ))
    }
  </div>
  <OpenHash />
</Base>
