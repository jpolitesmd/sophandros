---
import Base from "../../layouts/Base.astro";
import Progress from "../../components/Progress.astro";
import Rich from "../../components/Rich.astro";
import { lessonNeighbors, module1Lessons, type PlannedLesson } from "../../data/lesson-plan";

export function getStaticPaths() {
  return module1Lessons
    .filter((lesson) => lesson.status === "soon")
    .map((lesson) => ({
      params: { slug: lesson.slug },
      props: { lesson },
    }));
}

// Module 1 is fully taught. This route remains for any later soon-lesson
// that is given a /lessons URL. An empty list generates no pages.

interface Props {
  lesson: PlannedLesson;
}

const { lesson } = Astro.props;
const { prev, next } = lessonNeighbors(lesson.slug);
const place = module1Lessons.findIndex((item) => item.slug === lesson.slug) + 1;
---

<Base
  title={lesson.title}
  description={`${lesson.title} is a later lesson in Chapter 1 of Greece. The page is not written yet; the reading is listed.`}
>
  <div class="wrap-narrow">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/curriculum">Curriculum</a></li>
        <li><a href="/curriculum/the-heroic-code">The Heroic Code</a></li>
        <li aria-current="page">Lesson {place}</li>
      </ol>
    </nav>

    <header class="page-head" style="padding-top:1.25rem">
      <p class="kicker">Module I.1 · Lesson {place} · about {lesson.minutes} minutes · coming soon</p>
      <h1>{lesson.title}</h1>
      <p class="lede">
        This lesson stays inside the first layer, honor. It is planned and not yet
        written. The reading is below.
      </p>
    </header>

    <Progress current={lesson.slug} items={module1Lessons} markable={false} />

    <section class="learn">
      <h2>What this lesson will teach</h2>
      <p>The page is still to be written. The reading:</p>
      <p>
        <Rich text={lesson.reading} />
      </p>
    </section>

    <nav class="pager" aria-label="Lessons">
      {prev ? <a href={prev.href}>← {prev.title}</a> : <a href="/curriculum">← Curriculum</a>}
      {next && <a href={next.href}>{next.title} →</a>}
    </nav>
  </div>
</Base>
