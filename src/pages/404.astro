---
import Base from "../layouts/Base.astro";
---

<Base
  title="Page not found"
  description="This page is not part of the Sophandros preview."
>
  <header class="page-head wrap-narrow">
    <p class="kicker">404</p>
    <h1>This page is not in the prospectus</h1>
    <p class="lede">The address does not match a page on this preview.</p>
    <p class="flow-gap">
      <a class="button" href="/">Back to the beginning</a>
    </p>
  </header>
</Base>
